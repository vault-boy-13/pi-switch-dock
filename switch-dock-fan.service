[Unit]
Description=Switch Lite dock temperature-controlled fan
After=local-fs.target
Before=switch-frame-tap-viewer.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/pinctrl set 18 op dl
ExecStart=/usr/bin/python3 /usr/local/sbin/switch-dock-fan.py
ExecStopPost=/usr/bin/pinctrl set 18 op dl
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
