+/* pi-switch-dock: high-resolution HDMI policy, modified 2026-11-03.
+ * SPDX-License-Identifier: GPL-2.0-only */
+#ifndef PI_DISPLAY_POLICY_H
+#define PI_DISPLAY_POLICY_H
+#include <stdlib.h>
+
+typedef struct { int width,height,refresh; } pi_display_mode;
+
+/* Select only advertised modes. High-resolution panels scale the <=1080p
+ * source themselves; prefer 120 Hz, then 60 Hz, instead of native 4K30. */
+static int pi_display_pick(const pi_display_mode *modes,int count,int allow120)
+{
+    int high=0,best=-1,score=-1;
+    for(int i=0;i<count;i++)if(modes[i].width>1920 || modes[i].height>1080)high=1;
+    if(!high)return -1;
+    for(int i=0;i<count;i++){
+        const pi_display_mode *m=&modes[i];
+        if(m->width!=1920 || m->height!=1080)continue;
+        int rank=-1;
+        if(allow120 && m->refresh>=119 && m->refresh<=121)rank=200-abs(m->refresh-120);
+        else if(m->refresh>=59 && m->refresh<=61)rank=100-abs(m->refresh-60);
+        if(rank>score){score=rank;best=i;}
+    }
+    return best;
+}
+
+#ifndef PI_DISPLAY_POLICY_TEST
+static int pi_display_fullscreen(SDL_Window *win)
+{
+    const char *driver=SDL_GetCurrentVideoDriver();
+    const char *setting=getenv("SFT_DISPLAY_POLICY");
+    if(!driver || strcmp(driver,"KMSDRM") || (setting && !strcmp(setting,"native")))
+        return SDL_SetWindowFullscreen(win,SDL_WINDOW_FULLSCREEN_DESKTOP);
+    int display=SDL_GetWindowDisplayIndex(win),count=SDL_GetNumDisplayModes(display);
+    if(count<=0)return SDL_SetWindowFullscreen(win,SDL_WINDOW_FULLSCREEN_DESKTOP);
+    SDL_DisplayMode *sdl=calloc((size_t)count,sizeof(*sdl));
+    pi_display_mode *modes=calloc((size_t)count,sizeof(*modes));
+    if(!sdl || !modes){free(sdl);free(modes);return SDL_SetWindowFullscreen(win,SDL_WINDOW_FULLSCREEN_DESKTOP);}
+    for(int i=0;i<count;i++)if(SDL_GetDisplayMode(display,i,&sdl[i])==0)
+        modes[i]=(pi_display_mode){sdl[i].w,sdl[i].h,sdl[i].refresh_rate};
+    int result=-1;
+    for(int allow120=1;allow120>=0;allow120--){
+        int selected=pi_display_pick(modes,count,allow120);
+        if(selected<0)break;
+        SDL_DisplayMode *mode=&sdl[selected];
+        if(SDL_SetWindowDisplayMode(win,mode)==0 && SDL_SetWindowFullscreen(win,SDL_WINDOW_FULLSCREEN)==0){
+            fprintf(stderr,"video: high-resolution display policy: HDMI %dx%d at %d Hz\n",mode->w,mode->h,mode->refresh_rate);
+            result=0;break;
+        }
+        fprintf(stderr,"video: HDMI %dx%d at %d Hz unavailable: %s\n",mode->w,mode->h,mode->refresh_rate,SDL_GetError());
+    }
+    free(sdl);free(modes);
+    if(result==0)return 0;
+    return SDL_SetWindowFullscreen(win,SDL_WINDOW_FULLSCREEN_DESKTOP);
+}
+#endif
+#endif
