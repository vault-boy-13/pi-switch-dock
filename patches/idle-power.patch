@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* pi-switch-dock: inactivity is measured from media, never USB/status traffic. */
+#ifndef PI_IDLE_POLICY_H
+#define PI_IDLE_POLICY_H
+#include <stdint.h>
+typedef struct {
+    uint64_t last_media_ms;
+    uint32_t media_serial, timeout_ms;
+    int sleeping;
+} pi_idle_policy;
+
+/* 1: enter economy, -1: resume, 0: keep current state. */
+static int pi_idle_step(pi_idle_policy *p, uint64_t now, uint32_t serial, int usb)
+{
+    if (!p->timeout_ms) return 0;
+    if (!usb || serial != p->media_serial) {
+        p->media_serial = serial;
+        p->last_media_ms = now;
+        if (p->sleeping) { p->sleeping = 0; return -1; }
+    } else if (!p->sleeping && now - p->last_media_ms >= p->timeout_ms) {
+        p->sleeping = 1;
+        return 1;
+    }
+    return 0;
+}
+#endif
