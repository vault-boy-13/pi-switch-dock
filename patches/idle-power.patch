+static void pi_idle_live_transition(int sleeping, void *opaque)
+{
+    pi_idle_live *live = opaque;
+    if (sleeping && !live->suspended) {
+        g_dec_stop = 1;
+        if (*live->thread) { SDL_WaitThread(*live->thread, NULL); *live->thread = NULL; }
+        pi_scan_hide();
+        av_frame_unref(live->show);
+        SDL_LockMutex(g_fm);
+        for (int i = 0; i < FQ; i++) av_frame_unref(g_fq[i]);
+        g_fh = g_fn = 0;
+        SDL_UnlockMutex(g_fm);
+        h264_close(live->dec);
+        memset(live->dec, 0, sizeof(*live->dec));
+        pi_audio_close();
+        if (*live->texture) { SDL_DestroyTexture(*live->texture); *live->texture = NULL; }
+        g_paint_tex = NULL;
+        up_reset();
+        *live->width = *live->height = 0;
+        g_menu = 1;
+        menu_draw(*live->renderer); /* one final static waiting frame */
+        live->suspended = 1;
+        fprintf(stderr, "power: decoder/audio released; static HDMI waiting\n");
+    } else if (!sleeping && live->suspended) {
+        if (h264_open(live->dec, 1, 1, g_hwdec) != 0) {
+            fprintf(stderr, "power: decoder resume failed\n");
+            pi_idle_failed = 1; g_quit = 1; return;
+        }
+        g_dec_low = 1; g_dec_fallback = 0;
+        if (live->dec->hwname) snprintf(g_dec_name, sizeof(g_dec_name), "GPU (%s)", live->dec->hwname);
+        else snprintf(g_dec_name, sizeof(g_dec_name), "1 thread");
+        g_dec_mode = g_dec_name;
+        pi_audio_open();
+        g_dec_reopen = 0;
+        g_dec_stop = 0;
+        key_request();
+        *live->thread = SDL_CreateThread(decoder_main, "decoder", live->args);
+        if (!*live->thread) { pi_idle_failed = 1; g_quit = 1; return; }
+        live->suspended = 0;
+        fprintf(stderr, "power: decoder/audio restored\n");
+    }
+}
