+/* pi-switch-dock: added 2026-11-03; SPDX-License-Identifier: GPL-2.0-only */
+/* Incoming media cadence, independent of decoder scheduling and frame drops. */
+#include <stdint.h>
+typedef struct {
+    uint64_t first;
+    uint32_t last,width,height,count;
+    int valid,fast;
+} pi_display_rate;
+
+static int pi_display_rate_sample(pi_display_rate *s,uint32_t id,uint32_t width,uint32_t height,
+                                  uint64_t tick,uint64_t frequency)
+{
+    if(!frequency)return 0;
+    if(!s->valid || id<s->last || width!=s->width || height!=s->height ||
+       tick<s->first || tick-s->first>frequency*4){
+        *s=(pi_display_rate){.first=tick,.last=id,.width=width,.height=height,.valid=1};
+        return 0;
+    }
+    s->last=id;s->count++;
+    uint64_t elapsed=tick-s->first;
+    if(elapsed>=frequency){
+        /* Hysteresis prevents flapping at a transient late frame. */
+        double fps=(double)s->count*frequency/elapsed;
+        if(fps>=48.0)s->fast=1;
+        else if(fps<=40.0)s->fast=0;
+        s->first=tick;s->count=0;
+    }
+    return s->fast && width>1280 && height>720;
+}
